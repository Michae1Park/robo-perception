<?xml version="1.0"?>
<package format="3">
  <name>ppp_perception</name>
  <version>0.1.0</version>
  <description>Perception nodes (Python, around the repo's vision/ package): detect (YOLOE), pose (FoundationPose
    client), grasp, place, and the ground-truth evaluator.</description>
  <maintainer email="parkmjb@gmail.com">Michael Park</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>ppp_interfaces</exec_depend>
  <exec_depend>ppp_geometry</exec_depend>
  <test_depend>launch_testing</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
