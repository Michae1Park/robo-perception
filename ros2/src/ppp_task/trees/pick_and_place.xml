<?xml version="1.0"?>
<!-- Pick-and-place from a prompt. task_manager ticks PickAndPlace once per target ({target} on the blackboard), and
     Recover after a failure. Poses are TCP poses (between the finger pads; +z = approach) in panda_link0; *_q are
     joint configurations from SelectPlans' IK chain. View / edit with Groot2.

     Look before you pick (D-023): the grasp has to suit the place too, so the shelf is looked at first and a grasp +
     placement pair is chosen together. Stage 5 offers placements for every stable rest pose, upright first (D-031). -->
<root BTCPP_format="4">

  <BehaviorTree ID="PickAndPlace">
    <Sequence>
      <MoveToJoints pose="home"/>
      <Gripper position="0.04"/>
      <SubTree ID="Perceive" _autoremap="true"/>
      <SubTree ID="Pick" _autoremap="true"/>
      <SubTree ID="Place" _autoremap="true"/>
      <MoveToJoints pose="home"/>
    </Sequence>
  </BehaviorTree>

  <!-- Fixed camera: the object (stages 1 + 2) and grasps (3 + 4). Wrist camera: where it fits on the shelf (5).
       Then: which grasp + placement pairs the arm can reach, collision-free. -->
  <BehaviorTree ID="Perceive">
    <Sequence>
      <EstimatePose target="{target}" object_pose="{object_pose}"/>
      <PlanGrasps target="{target}" object_pose="{object_pose}" grasps="{grasps}" obstacles="{obstacles}"/>
      <UpdateScene obstacles="{obstacles}" id="table_clutter"/>
      <MoveToJoints pose="look"/>
      <GetPlacements target="{target}" placements="{placements}" obstacles="{shelf_obstacles}"/>
      <UpdateScene obstacles="{shelf_obstacles}" id="shelf_clutter"/>
      <SelectPlans target="{target}" grasps="{grasps}" placements="{placements}" plans="{plans}"/>
      <AddTarget target="{target}" object_pose="{object_pose}"/>
    </Sequence>
  </BehaviorTree>

  <!-- Reach the grasp of the first plan whose motions work; close; lift; still holding it? It is now part of the
       robot for planning. -->
  <BehaviorTree ID="Pick">
    <Sequence>
      <RetryUntilSuccessful num_attempts="4">
        <Sequence>
          <PopPlan plans="{plans}" grasp="{grasp}" grasp_pose="{grasp_pose}" lifted="{lifted}" place="{place}"
                   depart="{depart}" pregrasp="{pregrasp}" pregrasp_q="{pregrasp_q}" lifted_q="{lifted_q}"
                   preplace_q="{preplace_q}"/>
          <MoveToJoints joints="{pregrasp_q}"/>
          <RemoveTarget target="{target}"/>   <!-- the fingers go around it now -->
          <MoveLinear pose="{grasp_pose}"/>
        </Sequence>
      </RetryUntilSuccessful>
      <Gripper position="0.0"/>
      <MoveLinear pose="{lifted}" min_fraction="0.9"/>
      <CheckGrasp/>
      <AttachObject target="{target}" grasp="{grasp}"/>
    </Sequence>
  </BehaviorTree>

  <!-- Into the shelf, check it is still held, release, back out along the gripper axis (dragging the open fingers
       sideways would roll a can off the board). -->
  <BehaviorTree ID="Place">
    <Sequence>
      <MoveToJoints joints="{preplace_q}"/>
      <MoveLinear pose="{place}"/>
      <CheckGrasp/>
      <Gripper position="0.04"/>
      <DetachObject target="{target}"/>
      <ForceSuccess><MoveLinear pose="{depart}" min_fraction="0.3"/></ForceSuccess>
    </Sequence>
  </BehaviorTree>

  <!-- After a failure (same blackboard). Never drop the object somewhere random (D-030): still in the hand -> put it
       back where it was picked; then home (holding it if putting it back failed). -->
  <BehaviorTree ID="Recover">
    <Sequence>
      <ForceSuccess>
        <Sequence>
          <CheckGrasp/>
          <MoveToJoints joints="{lifted_q}"/>
          <MoveLinear pose="{grasp_pose}" min_fraction="0.9"/>
          <Gripper position="0.04"/>
          <DetachObject target="{target}"/>
          <MoveLinear pose="{pregrasp}" min_fraction="0.5"/>
        </Sequence>
      </ForceSuccess>
      <MoveToJoints pose="home"/>
    </Sequence>
  </BehaviorTree>

</root>
