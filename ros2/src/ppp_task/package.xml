<?xml version="1.0"?>
<package format="3">
  <name>ppp_task</name>
  <version>0.1.0</version>
  <description>Task manager (BehaviorTree.CPP v4, D-014): pick the prompted object from the table, look at the shelf,
    place it where stage 5 finds room. Motion through MoveIt 2.</description>
  <maintainer email="parkmjb@gmail.com">Michael Park</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>behaviortree_cpp</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>moveit_core</depend>
  <depend>geometric_shapes</depend>
  <depend>control_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_eigen</depend>
  <depend>ament_index_cpp</depend>
  <depend>ppp_interfaces</depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
