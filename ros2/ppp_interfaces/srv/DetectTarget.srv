# Visual-prompt detection of one target object in an RGB frame.
string target                 # object name; its visual prompt is registered in the detector
sensor_msgs/Image rgb
---
bool success
string message
float32[4] bbox               # x1, y1, x2, y2 (pixels)
float32 score
sensor_msgs/Image mask        # mono8, 255 = target, same size/stamp as rgb
float32 latency_ms
