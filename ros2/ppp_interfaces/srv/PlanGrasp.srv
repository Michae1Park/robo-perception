string target
geometry_msgs/PoseStamped object_pose   # world frame
float64 table_height
---
bool success
string message
geometry_msgs/PoseStamped grasp         # panda_hand pose at grasp
geometry_msgs/PoseStamped pregrasp      # panda_hand pose before approach
sensor_msgs/JointState pregrasp_joints  # IK solution for pregrasp
geometry_msgs/Pose object_to_hand       # hand pose expressed in the object frame
float64 width                           # object width between the fingers (m)
int32 num_candidates
int32 num_feasible
float32 latency_ms
