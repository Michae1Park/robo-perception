# Spatial perception: table plane + free space of the place zone.
sensor_msgs/Image depth       # 32FC1, metres
sensor_msgs/CameraInfo camera_info
---
bool success
string message
float64[4] plane              # a, b, c, d in world frame (a x + b y + c z + d = 0, c > 0)
float64 table_height          # plane height at the place-zone centre
int32 plane_inliers
nav_msgs/OccupancyGrid place_zone   # 0 free, 100 occupied, -1 unobserved
float32 latency_ms
