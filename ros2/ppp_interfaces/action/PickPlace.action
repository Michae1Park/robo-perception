# Pick the object shown by the visual prompt `target` and put it in a free spot of the place zone.
string target
---
bool success
string failed_stage          # empty on success
string message
float32[4] bbox
float32 detection_score
geometry_msgs/PoseStamped estimated_pose
geometry_msgs/PoseStamped grasp
geometry_msgs/PoseStamped planned_place
builtin_interfaces/Time image_stamp
string[] stage_names
float32[] stage_latency_ms
---
string stage                 # detect | pose | scene | grasp_plan | place_plan | approach | grasped | lifted | placing | released | done
