<?xml version="1.0"?>
<package format="3">
  <name>ppp_eval</name>
  <version>0.1.0</version>
  <description>Automated ground-truth evaluation of the pick-and-place pipeline.</description>
  <maintainer email="parkmjb@gmail.com">Michael Park</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>ppp_common</exec_depend>
  <exec_depend>ppp_interfaces</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
